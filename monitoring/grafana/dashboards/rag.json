{
  "uid": "rag-overview",
  "title": "RAG App Overview",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "App CPU (cores)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prom-ds" },
          "expr": "rate(process_cpu_seconds_total{job=\"app\"}[$__rate_interval])"
        }
      ]
    },
    {
      "id": 2,
      "title": "App RAM (RSS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prom-ds" },
          "expr": "process_resident_memory_bytes{job=\"app\"}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Request latency p50 / p90 / p99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "p50",
          "datasource": { "type": "prometheus", "uid": "prom-ds" },
          "expr": "histogram_quantile(0.5, sum(rate(rag_request_duration_seconds_bucket{job=\"app\"}[$__rate_interval])) by (le))"
        },
        {
          "refId": "p90",
          "datasource": { "type": "prometheus", "uid": "prom-ds" },
          "expr": "histogram_quantile(0.9, sum(rate(rag_request_duration_seconds_bucket{job=\"app\"}[$__rate_interval])) by (le))"
        },
        {
          "refId": "p99",
          "datasource": { "type": "prometheus", "uid": "prom-ds" },
          "expr": "histogram_quantile(0.99, sum(rate(rag_request_duration_seconds_bucket{job=\"app\"}[$__rate_interval])) by (le))"
        }
      ]
    },
    {
      "id": 4,
      "title": "Response delay (avg)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prom-ds" },
          "expr": "sum(rate(rag_request_duration_seconds_sum{job=\"app\"}[$__rate_interval])) / sum(rate(rag_request_duration_seconds_count{job=\"app\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 5,
      "title": "LLM tokens (request vs reply)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prom-ds" },
          "expr": "sum by (direction) (rate(rag_llm_tokens_total{job=\"app\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 6,
      "title": "Qdrant requests",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prom-ds" },
          "expr": "sum(rate(rest_responses_total[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 7,
      "title": "Qdrant query latency (avg)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prom-ds" },
          "expr": "sum(rate(rest_responses_duration_seconds_sum[$__rate_interval])) / sum(rate(rest_responses_duration_seconds_count[$__rate_interval]))"
        }
      ]
    }
  ]
}
